  "sandbox": {
    "provider": "Claude Code built-in",
    "runtime": "Node.js via child_process spawn",
    "capabilities": [
      "Node.js execution",
      "subprocess spawning",
      "stdio communication",
      "file system access (sandboxed)",
      "environment variable access"
    ],
    "security": {
      "isolation": "Google's gvisor container",
      "credentials": "Passed via environment variables",
      "network": "Limited to MCP subprocess communication"
    }
  },

  "implementation": {
    "wrapperGenerator": "scripts/generate-mcp-wrappers.ts",
    "generatorCapabilities": [
      "Reads MCP tool schemas via tools/list",
      "Generates TypeScript wrapper functions",
      "Handles MCP protocol initialization",
      "Manages subprocess lifecycle",
      "Parses JSON-RPC responses"
    ],
    "protocol": {
      "version": "2024-11-05",
      "transport": "stdio (JSON-RPC over stdin/stdout)",
      "initialization": "Required before tool calls",
      "methods": [
        "initialize",
        "tools/list",
        "tools/call"
      ]
    }
  },

  "benefits": {
