    "atlassian": {
      "command": "npx -y mcp-atlassian",
      "transport": "stdio",
      "package": "mcp-atlassian",
      "version": "2.1.0",
      "wrapperPath": "servers/atlassian/",
      "coverage": {
        "jira": "17 tools",
        "confluence": "24 tools",
        "total": "41 tools"
      },
      "authentication": {
        "type": "API Token",
        "credentials": {
          "baseUrl": "ATLASSIAN_BASE_URL environment variable",
          "email": "ATLASSIAN_EMAIL environment variable",
          "apiToken": "ATLASSIAN_API_TOKEN environment variable"
        },
        "source": "configs/.mcp.atlassian.json"
      },
      "status": "in-progress",
      "note": "Integration in progress - following methodology.md for MCP integration",
      "integrationDate": "2025-11-22"
    }
