{
  "architecture": "custom-filesystem-based",
  "approach": "TypeScript wrappers for stdio MCPs",
  "decision": "Option 2 - Abandoned pctx, built custom filesystem-based implementation",
  "decisionDate": "2025-11-22",
  "decisionRationale": "pctx designed for HTTP MCPs, our Google MCPs use stdio transport. Custom implementation follows Anthropic's Code Execution with MCP concept more directly.",

  "mcpServers": {
    "google-tasks": {
      "command": "bunx @brandcast_app/google-tasks-mcp",
      "transport": "stdio",
      "package": "@brandcast_app/google-tasks-mcp",
      "version": "0.1.0",
      "wrapperPath": "servers/google-tasks/",
      "tools": [
        {
          "name": "listProviders",
          "wrapperFile": "list_providers.ts",
          "description": "Get list of available task management providers"
        },
        {
          "name": "listTaskLists",
          "wrapperFile": "list_task_lists.ts",
          "description": "Get all task lists/projects from Google Tasks",
          "tested": true,
          "testDate": "2025-11-22",
          "testResult": "SUCCESS - returned 4 task lists"
        },
        {
          "name": "getTasks",
          "wrapperFile": "get_tasks.ts",
          "description": "Retrieve tasks from a specific list with optional filtering"
        },
        {
          "name": "createTask",
          "wrapperFile": "create_task.ts",
          "description": "Create a new task in a specific list"
        },
        {
          "name": "updateTask",
          "wrapperFile": "update_task.ts",
          "description": "Update an existing task"
        },
        {
          "name": "completeTask",
          "wrapperFile": "complete_task.ts",
          "description": "Mark a task as completed"
        },
        {
          "name": "deleteTask",
          "wrapperFile": "delete_task.ts",
          "description": "Delete a task permanently"
        },
        {
          "name": "searchTasks",
          "wrapperFile": "search_tasks.ts",
          "description": "Search tasks across all lists"
        },
        {
          "name": "syncAllTasks",
          "wrapperFile": "sync_all_tasks.ts",
          "description": "Fetch and sync tasks from all lists"
        }
      ],
      "authentication": {
        "type": "OAuth 2.0",
        "credentials": {
          "clientId": "GOOGLE_CLIENT_ID environment variable",
          "clientSecret": "GOOGLE_CLIENT_SECRET environment variable",
          "refreshToken": "GOOGLE_REFRESH_TOKEN environment variable"
        },
        "source": "/home/emyth/PAI/.claude/.mcp.google.json"
      }
    },
    "google-calendar": {
      "command": "bunx @cocal/google-calendar-mcp",
      "transport": "stdio",
